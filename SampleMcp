package com.company.investment.mcp.service;

import com.company.investment.mcp.client.InvestmentApiClient;

import com.company.investment.mcp.model.InsightFilter;
import com.company.investment.mcp.model.InsightRequest;
import com.company.investment.mcp.model.InsightResponse;
import com.company.investment.mcp.model.InsightType;

import org.springframework.stereotype.Service;

import java.util.Map;

@Service
public class InvestmentInsightService {

    private final InsightClassificationService classifier;

    private final UserIdentityService identityService;

    private final InvestmentApiClient apiClient;

    public InvestmentInsightService(
            InsightClassificationService classifier,
            UserIdentityService identityService,
            InvestmentApiClient apiClient) {

        this.classifier = classifier;

        this.identityService = identityService;

        this.apiClient = apiClient;
    }

    public InsightResponse getInsights(String prompt) {

        InsightFilter filter =
            classifier.classify(prompt);

        if (filter.insightType() == InsightType.UNKNOWN) {

            throw new IllegalArgumentException(
                "Unsupported insight type"
            );
        }

        String userGpn =
            identityService.getUserGpn();

        String token =
            identityService.getBearerToken();

        InsightRequest request =
            new InsightRequest(filter);

        Map<String, Object> data =
            apiClient.fetchInsights(
                token,
                userGpn,
                request
            );

        return new InsightResponse(
            userGpn,
            filter.insightType(),
            filter,
            data
        );
    }
}



