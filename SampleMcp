package com.company.investment.mcp.tools;

import com.company.investment.mcp.model.InsightFilter;
import com.company.investment.mcp.model.InsightType;

import com.company.investment.mcp.service.InsightClassificationService;

import org.springframework.stereotype.Component;

import org.springframework.ai.mcp.annotation.McpTool;
import org.springframework.ai.mcp.annotation.McpToolParam;

import java.util.Arrays;
import java.util.List;

@Component
public class InsightClassificationTools {

    private final InsightClassificationService classifier;

    public InsightClassificationTools(
            InsightClassificationService classifier) {

        this.classifier = classifier;
    }

    @McpTool(
        name = "classify_insight_request",
        description = """
            Classifies the user's investment insight request.

            Supported types:
            HOLDINGS,
            ASSET_ALLOCATION,
            PERFORMANCE,
            TRANSACTIONS,
            PORTFOLIO_SUMMARY.

            holdingsFlag must be true for HOLDINGS and
            ASSET_ALLOCATION.

            holdingsFlag must be false for other types.

            Does not fetch external investment data.
            """
    )
    public InsightFilter classify(

        @McpToolParam(
            description = "Original investment question from user",
            required = true
        )

        String userPrompt

    ) {

        return classifier.classify(userPrompt);
    }

    @McpTool(
        name = "get_supported_insight_types",
        description = """
            Returns all investment insight categories supported
            by this MCP server.

            Does not fetch investment data.
            """
    )
    public List<String> getSupportedInsightTypes() {

        return Arrays.stream(InsightType.values())

            .filter(type -> type != InsightType.UNKNOWN)

            .map(Enum::name)

            .toList();
    }
}


