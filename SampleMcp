package com.company.investment.mcp.client;

import com.company.investment.mcp.config.InsightProperties;
import com.company.investment.mcp.model.InsightRequest;

import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;

import org.springframework.stereotype.Component;

import org.springframework.web.client.RestClient;

import java.util.Map;

@Component
public class InvestmentApiClient {

    private final RestClient restClient;

    private final InsightProperties properties;

    public InvestmentApiClient(
            RestClient investmentRestClient,
            InsightProperties properties) {

        this.restClient = investmentRestClient;

        this.properties = properties;
    }

    public Map<String, Object> fetchInsights(
            String token,
            String userGpn,
            InsightRequest request) {

        return restClient.post()

            .uri(properties.insightsPath())

            .header(
                HttpHeaders.AUTHORIZATION,
                "Bearer " + token
            )

            .header(
                "x_user_gpn",
                userGpn
            )

            .contentType(MediaType.APPLICATION_JSON)

            .accept(MediaType.APPLICATION_JSON)

            .body(request)

            .retrieve()

            .body(Map.class);
    }
}


