package com.company.investment.mcp.service;

import com.company.investment.mcp.model.InsightFilter;
import com.company.investment.mcp.model.InsightType;

import org.springframework.stereotype.Service;

import java.util.Locale;

@Service
public class InsightClassificationService {

    public InsightFilter classify(String prompt) {

        if (prompt == null || prompt.isBlank()) {
            throw new IllegalArgumentException(
                "User prompt cannot be empty"
            );
        }

        String normalized = prompt
            .toLowerCase(Locale.ROOT)
            .replaceAll("[^a-z0-9_ ]", " ");

        InsightType type;

        if (normalized.matches("(?s).*\\bholdings\\b.*")) {

            type = InsightType.HOLDINGS;

        } else if (
            normalized.contains("asset allocation")
            || normalized.contains("asset_allocation")
        ) {

            type = InsightType.ASSET_ALLOCATION;

        } else if (normalized.contains("performance")) {

            type = InsightType.PERFORMANCE;

        } else if (normalized.contains("transactions")) {

            type = InsightType.TRANSACTIONS;

        } else if (
            normalized.contains("portfolio summary")
        ) {

            type = InsightType.PORTFOLIO_SUMMARY;

        } else {

            type = InsightType.UNKNOWN;
        }

        boolean holdingsFlag =
            type == InsightType.HOLDINGS
            || type == InsightType.ASSET_ALLOCATION;

        return new InsightFilter(
            type,
            holdingsFlag
        );
    }
}


