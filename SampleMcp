package com.company.investment.mcp.tools;

import com.company.investment.mcp.model.InsightResponse;

import com.company.investment.mcp.service.InvestmentInsightService;

import org.springframework.stereotype.Component;

import org.springframework.ai.mcp.annotation.McpTool;
import org.springframework.ai.mcp.annotation.McpToolParam;

@Component
public class InvestmentInsightTools {

    private final InvestmentInsightService service;

    public InvestmentInsightTools(
            InvestmentInsightService service) {

        this.service = service;
    }

    @McpTool(
        name = "get_investment_insights",
        description = """
            Retrieves the authenticated user's investment insights.

            Classify the original user prompt and determine insightType.

            Set holdingsFlag=true for:
            HOLDINGS
            ASSET_ALLOCATION

            Set holdingsFlag=false for:
            PERFORMANCE
            TRANSACTIONS
            PORTFOLIO_SUMMARY

            Extract userGpn from the authenticated harness JWT.

            Forward the authenticated bearer token to the external API.

            Set x_user_gpn using the authenticated user's GPN.

            Never request authentication tokens or GPN from users.

            Use this tool to retrieve actual investment data.
            """
    )
    public InsightResponse getInvestmentInsights(

        @McpToolParam(
            description = "Original user investment question",
            required = true
        )

        String userPrompt

    ) {

        return service.getInsights(userPrompt);
    }
}



